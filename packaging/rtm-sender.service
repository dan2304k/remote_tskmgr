# systemd user unit for the RTM sender.
# Install: see packaging/README.md. Config: ~/.config/rtm/sender.toml (hot reloaded).
[Unit]
Description=RTM sender (pushes system stats to RTM viewers on the LAN)
Documentation=https://github.com/dan2304k/remote_tskmgr
# network-online.target is a system unit; a user unit cannot order against it. The sender
# copes with no network at start (it retries sends and re-enumerates interfaces).

[Service]
Type=simple
# --no-gui: with the gui build, never try to open the tray from a service.
ExecStart=%h/.local/bin/rtm-sender --no-gui
Environment=RTM_LOG=info
Restart=on-failure
RestartSec=5
# Ctrl-C equivalent; the sender handles SIGTERM and exits cleanly.
KillSignal=SIGTERM
TimeoutStopSec=5
Nice=10

[Install]
WantedBy=default.target
